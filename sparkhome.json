{
  "settings": {
    "port": 8780, "lan": false,
    "chrome": "google-chrome", "chrome_profile": "~/.local/share/sparkhome/chrome", "cdp_port": 9223,
    "chrome_flags": ["--enable-spatial-navigation"],
    "max_web_tabs": 4,
    "steam_root": "~/snap/steam/common/.local/share/Steam", "steam_pipe": "~/snap/steam/common/.steam/steam.pipe",
    "gamespark": "~/gamespark", "steam_setup": "fex", "steam_autostart": true,
    "demo_steam_root": "~/.cache/sparkhome/demo-steam",
    "hotkeys": {"home": ["XF86HomePage", "XF86Launch5"], "voice": ["XF86Launch6"]},
    "gamepad": {"home": "BTN_MODE", "home_hold_in_app_ms": 600},
    "siri_remote": {"enabled": true},
    "mic": "default",
    "asr": {"server": "http://127.0.0.1:8781",
            "server_cmd": ["~/whisper.cpp/build/bin/whisper-server", "-m", "~/whisper.cpp/models/ggml-large-v3-turbo-q8_0.bin", "--host", "127.0.0.1", "--port", "8781", "-l", "en"],
            "cli": ["~/whisper.cpp/build/bin/whisper-cli", "-m", "~/whisper.cpp/models/ggml-large-v3-turbo-q8_0.bin", "-l", "en", "-nt", "-np"],
            "env": {"LD_LIBRARY_PATH": "~/whisper.cpp/build/bin"}},
    "tts": {"enabled": false, "server": "http://127.0.0.1:8782",
            "server_cmd": ["~/.local/share/sparkhome/tts/kokoro/venv/bin/python", "-I", "tools/tts_server.py", "--port", "8782", "--model", "~/.local/share/sparkhome/tts/kokoro/kokoro-v1.0.int8.onnx", "--voices", "~/.local/share/sparkhome/tts/kokoro/voices-v1.0.bin", "--voice", "bf_emma", "--threads", "4"],
            "cmd": ["~/piper/venv/bin/python", "-m", "piper", "-m", "~/piper/voices/en_US-lessac-medium.onnx", "-f", "{out}"]},
    "llm": {"api": "ollama", "base_url": "http://127.0.0.1:11434", "model": "qwen3:4b-instruct-2507-q4_K_M",
            "num_ctx": 8192, "keep_alive": "30m", "timeout_s": 20, "gate_in_app": true},
    "llm_big": {"api": "openai", "base_url": "http://127.0.0.1:8001", "model": "nemotron-3.5-lightning",
                "timeout_s": 15, "while_gaming": false},
    "request_log": true,
    "mcp_servers": [],
    "plugins": {}
  },
  "user_agents": {"tv": "Mozilla/5.0 (PS4; Leanback Shell) Cobalt/25.lts.40.1035033; compatible; SparkHome/0.1"},
  "rows": [
    {"id": "top", "style": "dock", "tiles": ["youtube", "netflix", "steam:1091500", "plex", "spotify", "bigpicture"]},
    {"id": "streaming", "title": "Streaming", "style": "icons",
     "tiles": ["netflix", "youtube", "disney", "max", "prime", "hulu", "appletv", "paramount", "peacock", "crunchyroll", "twitch", "spotify", "youtubetv"]},
    {"id": "games", "title": "Games", "style": "posters", "auto": "steam",
     "tiles": ["bigpicture", "xcloud", "luna", "geforcenow", "retroarch", "dolphin", "ppsspp", "prism", "supertuxkart", "moonlight"]},
    {"id": "lab", "title": "Home Lab", "style": "icons", "tiles": ["dashboard", "openwebui", "comfyui", "jellyfin", "plex", "terminal"]},
    {"id": "system", "title": "System", "style": "widgets", "tiles": ["gpu", "memory", "models", "settings"]}
  ],
  "tiles": {
    "netflix": {"type": "web", "title": "Netflix", "color": "#E50914", "note": "Up to 1080p · stereo",
                "url": "https://www.netflix.com/browse", "search": "https://www.netflix.com/search?q={q}", "back": "history",
                "skin": true, "shows": true},
    "youtube": {"type": "web", "title": "YouTube", "color": "#FF0000", "note": "TV interface",
                "url": "https://www.youtube.com/tv", "ua": "tv", "search": "https://www.youtube.com/tv#/search?q={q}",
                "back": "escape", "nav": "keys", "tiles": "yt-lockup-view-model"},
    "youtubetv": {"type": "web", "title": "YouTube TV", "subtitle": "Live TV", "color": "#CC0000", "note": "Live TV · needs location access",
                  "url": "https://www.youtube.com/tv/upg", "ua": "tv", "back": "escape", "nav": "keys",
                  "tiles": "yt-lockup-view-model"},
    "disney": {"type": "web", "title": "Disney+", "color": "#113CCF", "note": "Up to 720p · 480p reported on Linux",
               "url": "https://www.disneyplus.com/", "skin": true},
    "max": {"type": "web", "title": "HBO Max", "color": "#5B2BE0", "note": "Not supported on Linux · may not play",
            "url": "https://play.hbomax.com/", "skin": true},
    "prime": {"type": "web", "title": "Prime Video", "color": "#00A8E1", "note": "SD on Linux",
              "url": "https://www.primevideo.com/", "search": "https://www.primevideo.com/search/ref=atv_nb_sug?phrase={q}",
              "skin": true, "shows": true},
    "hulu": {"type": "web", "title": "Hulu", "color": "#1CE783", "note": "480p or less (no HDCP)",
             "url": "https://www.hulu.com/hub/home", "search": "https://www.hulu.com/search?q={q}", "skin": true, "shows": true},
    "appletv": {"type": "web", "title": "Apple TV", "color": "#2B2B30", "note": "Untested on Linux · 720p at best",
                "url": "https://tv.apple.com/", "search": "https://tv.apple.com/us/search?term={q}", "skin": true, "shows": true},
    "paramount": {"type": "web", "title": "Paramount+", "color": "#0064FF", "note": "Untested on Linux",
                  "url": "https://www.paramountplus.com/", "search": "https://www.paramountplus.com/search/?q={q}",
                  "skin": true, "shows": true},
    "peacock": {"type": "web", "title": "Peacock", "color": "#1A1A1A", "note": "May not play on Linux",
                "url": "https://www.peacocktv.com/watch/home", "search": "https://www.peacocktv.com/watch/search?q={q}",
                "skin": true, "shows": true},
    "crunchyroll": {"type": "web", "title": "Crunchyroll", "color": "#F47521", "note": "Untested on Linux",
                    "url": "https://www.crunchyroll.com/", "search": "https://www.crunchyroll.com/search?q={q}", "skin": true, "shows": true},
    "twitch": {"type": "web", "title": "Twitch", "color": "#9146FF", "note": "Up to 1080p60",
               "url": "https://www.twitch.tv/", "search": "https://www.twitch.tv/search?term={q}",
               "skin": {"hide": ["[data-a-target=consent-banner]", "#twilight-sticky-footer-root"]}},
    "spotify": {"type": "web", "title": "Spotify", "color": "#1DB954", "note": "AAC 256 kbps (Premium)",
                "url": "https://open.spotify.com/", "search": "https://open.spotify.com/search/{q}", "skin": true},
    "plex": {"type": "web", "title": "Plex", "color": "#E5A00D", "note": "HEVC and Dolby audio transcode",
             "url": "https://app.plex.tv/desktop/", "search": "https://app.plex.tv/desktop/#!/search?query={q}",
             "skin": true, "shows": true},

    "bigpicture": {"type": "steam", "title": "Steam Big Picture", "subtitle": "Your whole Steam library", "color": "#1B2838",
                   "uri": "steam://open/bigpicture"},
    "xcloud": {"type": "web", "title": "Xbox Cloud Gaming", "subtitle": "Game Pass in the browser", "color": "#107C10", "note": "Up to 1080p",
               "url": "https://www.xbox.com/play", "search": "https://www.xbox.com/en-US/play/search?q={q}", "nav": "pad"},
    "luna": {"type": "web", "title": "Amazon Luna", "color": "#5A2D82", "note": "Untested on Linux",
             "url": "https://luna.amazon.com/", "search": "https://luna.amazon.com/search?query={q}", "nav": "pad"},
    "geforcenow": {"type": "web", "title": "GeForce NOW", "color": "#76B900", "note": "Browser · up to 1080p60",
                   "url": "https://play.geforcenow.com/", "nav": "pad"},
    "retroarch": {"type": "exec", "title": "RetroArch", "subtitle": "Retro consoles", "color": "#3A3A3A",
                  "argv": ["flatpak", "run", "org.libretro.RetroArch"], "cpus": "5-9,15-19", "window_class": "retroarch"},
    "dolphin": {"type": "exec", "title": "Dolphin", "subtitle": "GameCube & Wii", "color": "#2A73C5",
                "argv": ["flatpak", "run", "org.DolphinEmu.dolphin-emu"], "cpus": "5-9,15-19",
                "window_class": "dolphin-emu"},
    "ppsspp": {"type": "exec", "title": "PPSSPP", "subtitle": "PSP", "color": "#1F5FA8",
               "argv": ["flatpak", "run", "org.ppsspp.PPSSPP"], "cpus": "5-9,15-19",
               "window_class": "org.ppsspp.PPSSPP"},
    "prism": {"type": "exec", "title": "Minecraft", "subtitle": "Prism Launcher", "color": "#3C8527",
              "argv": ["flatpak", "run", "org.prismlauncher.PrismLauncher"],
              "window_class": ["PrismLauncher", "Minecraft*"]},
    "supertuxkart": {"type": "exec", "title": "SuperTuxKart", "color": "#E8A33D",
                     "argv": ["flatpak", "run", "net.supertuxkart.SuperTuxKart"], "window_class": "supertuxkart"},
    "moonlight": {"type": "exec", "title": "Moonlight", "subtitle": "Stream from your PC", "color": "#3B4E8C",
                  "argv": ["flatpak", "run", "com.moonlight_stream.Moonlight"],
                  "window_class": ["Moonlight", "com.moonlight_stream.Moonlight"]},

    "dashboard": {"type": "web", "title": "DGX Dashboard", "color": "#76B900", "url": "http://127.0.0.1:11000/"},
    "openwebui": {"type": "web", "title": "Open WebUI", "color": "#3D3D3D", "url": "http://127.0.0.1:8080/"},
    "comfyui": {"type": "web", "title": "ComfyUI", "color": "#2D2D6E", "url": "http://127.0.0.1:8188/"},
    "jellyfin": {"type": "web", "title": "Jellyfin", "color": "#AA5CC3", "url": "http://127.0.0.1:8096/web/",
                 "search": "http://127.0.0.1:8096/web/#/search.html?query={q}", "nav": "pad", "shows": true},
    "terminal": {"type": "exec", "title": "Terminal", "color": "#300A24", "argv": ["gnome-terminal"], "game": false,
                 "window_class": "gnome-terminal-server"},

    "gpu": {"type": "widget", "widget": "gpu", "title": "GPU", "color": "#76B900"},
    "memory": {"type": "widget", "widget": "memory", "title": "Memory", "color": "#0A84FF"},
    "models": {"type": "widget", "widget": "models", "title": "AI Models", "color": "#BF5AF2"},
    "settings": {"type": "widget", "widget": "settings", "title": "Settings", "color": "#8E8E93"}
  }
}
